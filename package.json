{
  "name": "@ahm0xc/r2-navigator",
  "version": "0.1.0",
  "description": "Interactive terminal navigator for Cloudflare R2 buckets",
  "type": "module",
  "bin": {
    "r2n": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outfile dist/cli.js --target node --packages external --banner '#!/usr/bin/env node' && chmod +x dist/cli.js",
    "dev": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
